# ============================================================
# EdgeVoice — Edge Voice Activator for "Akash Go" (ESP32)
# .gitignore
# ============================================================

# ------------------------------------------------------------
# DATASETS  (raw audio, processed features, augmented clips,
#            speaker splits — kept out of the repo because of
#            size; regenerate with scripts/generate_dataset.py)
# ------------------------------------------------------------
dataset/raw/
dataset/augmented/
dataset/processed/
dataset/splits/

# Individual audio file types (wherever they appear)
*.wav
*.mp3
*.ogg
*.flac
*.aac
*.m4a

# Feature / numpy cache files
*.npy
*.npz
*.pkl
*.pickle

# ------------------------------------------------------------
# MODEL WEIGHTS  — !! INTENTIONALLY KEPT IN REPO !!
# The trained TFLite INT8 model, Keras checkpoints, and
# C-array header are small and critical for reproducibility.
# DO NOT add *.tflite, *.keras, *.h5, or model_data.h here.
# ------------------------------------------------------------

# ------------------------------------------------------------
# RESULTS & EXPERIMENT LOGS
# CSV experiment logs are generated by benchmark_model.py and
# are large or machine-specific — exclude from version control.
# Keep final_report.md (committed separately).
# ------------------------------------------------------------
results/model_experiments.csv
results/__pycache__/

