# PYTHON
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
wheels/
parts/
var/
sdist/
develop-eggs/
